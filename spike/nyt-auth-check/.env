# --- Endpoints (change here if NYT moves things) ---
NYT_BASE_URL=https://www.nytimes.com
# Latest daily puzzle
NYT_DAILY_LATEST_PATH=/svc/crosswords/v6/puzzle/daily.json

# Daily puzzle for a date; {date} is YYYY-MM-DD
NYT_DAILY_DATE_PATH=/svc/crosswords/v6/puzzle/daily/{date}.json

# Your saved progress for a puzzle; {puzzle_id} comes from the puzzle JSON
NYT_GAME_STATE_PATH=/svc/crosswords/v6/game/{puzzle_id}.json

# Some sources say the puzzle endpoints want this header. Try true/false.
NYT_AUTH_BYPASS=false

# --- Output ---
DATA_DIR=nyt/data
